{
  "name": "@chorus/collaboration-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Headless collaboration engine: owns provider processes, the event store and the approval queues.",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "chorus-engine": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node ./dist/main.js",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mohammadtmohsen/adapter-claude": "^1.0.0",
    "@mohammadtmohsen/adapter-codex": "^1.0.0",
    "@mohammadtmohsen/agent-protocol": "^1.0.0",
    "@chorus/collaboration-protocol": "workspace:*",
    "@chorus/collaboration-runtime": "workspace:*",
    "@mohammadtmohsen/event-store": "^1.0.0",
    "@mohammadtmohsen/shared": "^1.0.0",
    "@chorus/transport": "workspace:*"
  },
  "devDependencies": {
    "@mohammadtmohsen/orchestrator": "^1.0.0",
    "@types/node": "^22.20.1"
  }
}
