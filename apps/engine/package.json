{
  "name": "@chorus/collaboration-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Headless collaboration engine: owns provider processes, the event store and the approval queues.",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "chorus-engine": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node ./dist/main.js",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "@chorus/adapter-claude": "workspace:*",
    "@chorus/adapter-codex": "workspace:*",
    "@chorus/agent-protocol": "workspace:*",
    "@chorus/collaboration-protocol": "workspace:*",
    "@chorus/collaboration-runtime": "workspace:*",
    "@chorus/event-store": "workspace:*",
    "@chorus/shared": "workspace:*",
    "@chorus/transport": "workspace:*"
  },
  "devDependencies": {
    "@chorus/orchestrator": "workspace:*",
    "@types/node": "^22.20.1"
  }
}
