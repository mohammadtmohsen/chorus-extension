{
  "name": "@chorus/webview",
  "version": "0.0.0",
  "private": true,
  "description": "The conversation panel's UI. Runs in a webview, so it has no Node and no VS Code API.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "node ../../scripts/rm.mjs dist *.tsbuildinfo"
  },
  "dependencies": {
    "@chorus/collaboration-protocol": "workspace:*",
    "@chorus/shared": "workspace:*",
    "@chorus/transcript": "workspace:*",
    "@chorus/workspace": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0"
  }
}
